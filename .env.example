# AWS SES credentials (IAM user with ses:SendEmail / ses:SendRawEmail)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Admin API key for /api/* (X-API-Key header)
ADMIN_API_KEY=

# Relay hostname — Let's Encrypt cert is read from /etc/letsencrypt/live/<SMTP_DOMAIN>
SMTP_DOMAIN=

# Cloudflare token for the certbot DNS-01 challenge (Zone:DNS:Edit)
CLOUDFLARE_API_TOKEN=

# Optional tuning
SMTP_PORT=587
API_PORT=3000
DB_PATH=/data/relay.db
QUEUE_POLL_MS=10000
