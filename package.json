{
  "name": "ses-relay",
  "version": "2.0.0",
  "description": "SMTP Relay with AWS SES Tenant Tagging & Queuing (SQLite, zero external services)",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "migrate": "node scripts/migrate-from-mariadb.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.700.0",
    "express": "^4.21.2",
    "smtp-server": "^3.13.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/smtp-server": "^3.5.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
